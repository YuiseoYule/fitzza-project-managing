{
  "$schema":"https://json-schema.org/draft/2020-12/schema", "type":"object", "additionalProperties":false,
  "required":["id","title","phase","responsible","assistants","startDate","endDate","status","predecessorIds","deliverables","notes"],
  "properties": {
    "id":{"type":"string","pattern":"^TASK-[A-Za-z0-9_-]+$"}, "title":{"type":"string","minLength":1}, "phase":{"type":"string","minLength":1},
    "responsible":{"enum":["팀장","Cloud","PM","FE","BE"]}, "assistants":{"type":"array","items":{"enum":["팀장","Cloud","PM","FE","BE"]},"uniqueItems":true},
    "startDate":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"}, "endDate":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"}, "status":{"enum":["not_started","in_progress","blocked","completed"]},
    "predecessorIds":{"type":"array","items":{"type":"string"},"uniqueItems":true}, "deliverables":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["label","url"],"properties":{"label":{"type":"string","minLength":1},"url":{"type":"string","minLength":1}}}}, "notes":{"type":"string"}
  }
}
