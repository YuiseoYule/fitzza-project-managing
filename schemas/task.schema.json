{
  "$schema":"https://json-schema.org/draft/2020-12/schema", "type":"object", "additionalProperties":false,
  "required":["id","title","phase","responsible","assistants","startDate","endDate","weight","status","predecessorIds","deliverables","notes"],
  "properties": {
    "id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_-]*$"}, "wbs":{"type":"string"}, "section":{"type":"string"}, "title":{"type":"string","minLength":1}, "phase":{"type":"string","minLength":1}, "category":{"type":"string"},
    "responsible":{"enum":["팀장","Cloud","PM","FE","BE","경민","주희","지현","수혁","승원","준우","나연",""],"description":"역할 또는 지정된 담당자 이름. 빈 문자열은 담당자 미배정입니다."}, "assistants":{"type":"array","items":{"enum":["팀장","Cloud","PM","FE","BE","경민","주희","지현","수혁","승원","준우","나연"]},"uniqueItems":true},
    "startDate":{"type":"string","pattern":"^(\\d{4}-\\d{2}-\\d{2})?$"}, "endDate":{"type":"string","pattern":"^(\\d{4}-\\d{2}-\\d{2})?$"},
